datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  timezone              String                @default("America/New_York")
  phone                 String?
  email                 String?
  assistantName         String                @default("Walter")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  users                 User[]
  staff                 Staff[]
  customers             Customer[]
  services              Service[]
  availabilityRules     AvailabilityRule[]
  appointments          Appointment[]
  calendarIntegrations  CalendarIntegration[]
  conversations         Conversation[]
  phoneCalls            PhoneCall[]
  automationRules       AutomationRule[]
  notifications         Notification[]
  integrations          Integration[]
  auditLogs             AuditLog[]
  subscriptions         Subscription[]
  usageRecords          UsageRecord[]
}

model User {
  id           String     @id @default(uuid())
  businessId   String
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("ADMIN") // OWNER, ADMIN, STAFF, RECEPTIONIST
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        Staff?
  auditLogs    AuditLog[]

  @@index([businessId])
}

model Staff {
  id           String     @id @default(uuid())
  businessId   String
  userId       String?    @unique
  name         String
  email        String?
  phone        String?
  title        String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  availabilityRules AvailabilityRule[]
  appointments      Appointment[]
  calendarIntegrations CalendarIntegration[]

  @@index([businessId])
}

model Customer {
  id           String        @id @default(uuid())
  businessId   String
  name         String
  email        String?
  phone        String?
  segment      String?       @default("Standard") // High value, Needs confirmation, No-show risk, New lead
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  conversations Conversation[]
  phoneCalls   PhoneCall[]

  @@index([businessId])
  @@index([email])
  @@index([phone])
}

model Service {
  id              String        @id @default(uuid())
  businessId      String
  name            String
  description     String?
  durationMinutes Int           @default(30)
  bufferMinutes   Int           @default(15)
  price           Float         @default(0.0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments    Appointment[]

  @@index([businessId])
}

model AvailabilityRule {
  id           String    @id @default(uuid())
  businessId   String
  staffId      String?
  dayOfWeek    Int       // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime    String    // e.g. "08:00"
  endTime      String    // e.g. "17:00"
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([staffId])
}

model Appointment {
  id                 String                     @id @default(uuid())
  businessId         String
  customerId         String
  serviceId          String
  staffId            String?
  startTime          DateTime
  endTime            DateTime
  status             String                     @default("confirmed") // pending, confirmed, completed, cancelled, no-show risk, no-show
  channel            String                     @default("web") // phone, WhatsApp, email, web, manual
  notes              String?
  cancellationReason String?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  business           Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer           Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service            Service                    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staff              Staff?                     @relation(fields: [staffId], references: [id], onDelete: SetNull)

  statusHistory      AppointmentStatusHistory[]
  notifications      Notification[]

  @@index([businessId])
  @@index([customerId])
  @@index([staffId])
  @@index([startTime])
  @@index([status])
}

model AppointmentStatusHistory {
  id             String      @id @default(uuid())
  appointmentId String
  previousStatus String?
  newStatus      String
  changedBy      String      @default("system") // system, user, ai
  reason         String?
  createdAt      DateTime    @default(now())

  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model CalendarIntegration {
  id           String    @id @default(uuid())
  businessId   String
  staffId      String?
  provider     String    // GOOGLE, OUTLOOK
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  syncToken    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff        Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Conversation {
  id            String     @id @default(uuid())
  businessId    String
  customerId    String?
  channel       String     // PHONE, WHATSAPP, EMAIL, WEB, MANUAL
  intent        String?
  status        String     @default("Resolved") // Awaiting customer, Resolved, Human review, Escalated
  handler       String     @default("Walter")
  result        String?
  lastMessageAt DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  messages      Message[]
  phoneCalls    PhoneCall[]

  @@index([businessId])
  @@index([customerId])
  @@index([channel])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderType     String       // CUSTOMER, AI, STAFF
  content        String
  externalId     String?
  timestamp      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model PhoneCall {
  id                String           @id @default(uuid())
  businessId        String
  conversationId    String?
  customerId        String?
  callSid           String?
  provider          String           @default("local")
  providerCallId    String?
  direction         String           @default("INBOUND") // INBOUND, OUTBOUND
  status            String           @default("COMPLETED") // IN_PROGRESS, COMPLETED, FAILED
  duration          String?          @default("00:00")
  durationSeconds   Int              @default(0)
  recordingUrl      String?
  transcript        String?
  summary           String?
  intent            String?
  appointmentAction String?
  transferStatus    String?          @default("not needed")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  // New timestamps for lifecycle tracking
  startedAt         DateTime?
  answeredAt        DateTime?
  endedAt           DateTime?

  business          Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation      Conversation?    @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer          Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  transcripts       CallTranscript[]

  @@index([businessId])
  @@index([conversationId])
  @@unique([provider, providerCallId, businessId])
}

model CallTranscript {
  id          String    @id @default(uuid())
  phoneCallId String
  speaker     String    // CUSTOMER, AI, AGENT
  text        String
  timestamp   DateTime  @default(now())

  phoneCall   PhoneCall @relation(fields: [phoneCallId], references: [id], onDelete: Cascade)

  @@index([phoneCallId])
}

model AutomationRule {
  id           String    @id @default(uuid())
  businessId   String
  name         String
  triggerEvent String    // appointment.created, appointment.cancelled, etc.
  actionType   String    // send_notification, webhook, etc.
  payload      String?
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Notification {
  id            String       @id @default(uuid())
  businessId    String
  appointmentId String?
  channel       String       // EMAIL, WHATSAPP, SMS
  recipient     String
  template      String
  status        String       @default("QUEUED") // QUEUED, SENT, FAILED
  scheduledAt   DateTime?
  sentAt        DateTime?
  createdAt     DateTime     @default(now())

  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

model Integration {
  id         String   @id @default(uuid())
  businessId String
  provider   String   // TWILIO, SENDGRID, WHATSAPP_META, GOOGLE_CALENDAR, OUTLOOK
  config     String?  // JSON string
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
}

model Subscription {
  id             String   @id @default(uuid())
  businessId     String
  plan           String   @default("GROWTH") // STARTER, GROWTH, SCALE
  status         String   @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE
  currentPeriodEnd DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model UsageRecord {
  id          String   @id @default(uuid())
  businessId  String
  metric      String   // CALL_MINUTES, MESSAGES, APPOINTMENTS
  count       Int      @default(1)
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime @default(now())

  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}
